{
  "name": "basketball-scene-proxy",
  "version": "1.0.0",
  "description": "Proxy server for basketball scene authentication",
  "main": "proxy.js",
  "type": "module",
  "scripts": {
    "start": "node proxy.js",
    "dev": "nodemon proxy.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop basketball-scene-proxy",
    "pm2:restart": "pm2 restart basketball-scene-proxy",
    "pm2:reload": "pm2 reload basketball-scene-proxy",
    "pm2:delete": "pm2 delete basketball-scene-proxy",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs basketball-scene-proxy",
    "pm2:monit": "pm2 monit",
    "deploy": "./deploy.sh",
    "manage": "./manage.sh"
  },
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": ["proxy", "authentication", "basketball"],
  "author": "",
  "license": "MIT"
}
